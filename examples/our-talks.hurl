# Our examples for Talk submissions (workflow/specs/talks/spec.md), beyond the published happy path.
# Run: examples/run.sh [base-url]
# The speaker is registered with a unique email, so the file runs against a shared database. The
# speaker submits two talks; a speaker has at most 3.

POST {{base_url}}/speakers
{"name": "Barbara Liskov", "email": "liskov-{{newUuid}}@example.com"}
HTTP 201
[Captures]
liskov: jsonpath "$.id"

# R3: a title of 200 x 'x'
POST {{base_url}}/talks
{"title": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "format": "PRESENTATION", "level": "BEGINNER", "speakerId": {{liskov}}}
HTTP 201
[Asserts]
jsonpath "$.title" == "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# R3: a title of 201 x 'x'
POST {{base_url}}/talks
{"title": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "format": "PRESENTATION", "level": "BEGINNER", "speakerId": {{liskov}}}
HTTP 400

